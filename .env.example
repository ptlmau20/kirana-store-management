# =================================================================
# KIRANA STORE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Copy this file to .env or pass environment variables in production.
# NEVER commit real secrets to source control.
# =================================================================

# Server Port
PORT=8080

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/kirana_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Fallback In-Memory H2 Mode for instant local testing without pre-configured PostgreSQL
# DATABASE_URL=jdbc:h2:mem:kiranadb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
# DATABASE_USERNAME=sa
# DATABASE_PASSWORD=

# Security & JWT Configuration (Must be at least 256 bits / 32 characters)
JWT_SECRET=KiranaStoreSuperSecretSecurityJwtSigningKey2026SecureProductionTokenHeaderSecretKey
JWT_EXPIRATION_MS=86400000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

